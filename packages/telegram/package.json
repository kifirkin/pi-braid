{
  "name": "pi-braid-telegram",
  "version": "0.1.6",
  "description": "Talk to your pi coding agent from Telegram: send text or voice, get the answer back, and tap a button to decide.",
  "type": "module",
  "files": [
    "src/",
    "docs/",
    "README.md",
    "LICENSE",
    "build-info.json"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "keywords": [
    "pi-package",
    "braid",
    "pi-coding-agent",
    "telegram",
    "telegram-bot",
    "remote-control",
    "voice"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "prepublishOnly": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node test/run-tests.mjs",
    "check:doc-index": "node ../../packages/core/scripts/check-doc-index.mjs",
    "publish:local": "node ../../packages/core/scripts/publish-local.mjs telegram",
    "prepack": "npm run build && node ../../packages/core/scripts/pack-provenance.mjs write",
    "postpack": "node ../../packages/core/scripts/pack-provenance.mjs remove"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "typebox": "^1.1.38"
  },
  "author": "kifirkin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kifirkin/pi-braid.git",
    "directory": "packages/telegram"
  },
  "bugs": {
    "url": "https://github.com/kifirkin/pi-braid/issues"
  },
  "homepage": "https://github.com/kifirkin/pi-braid/tree/main/packages/telegram",
  "engines": {
    "node": ">=24.0.0"
  }
}
