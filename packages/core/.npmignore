# Source maps (bloat the package needlessly)
# Note: package.json "files" with negation patterns handles this more reliably
# See package.json: "dist/**/*.js", "dist/**/*.d.ts" (no .map)

# Development/test (not for consumers)
test/
scripts/

# Internal config files (not for consumers)
.gitignore
.githooks/
.prettierignore
.prettierrc
.eslintrc*
eslint.config.js

# node_modules
node_modules/

# Python (none should exist, but defensive)
*.py
__pycache__/
