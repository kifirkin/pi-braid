{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ES2022"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "key-ring.ts",
    "ring-lifecycle.ts",
    "log.ts",
    "venice-catalog.ts",
    "failure-translation.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
