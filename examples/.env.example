# pi-braid — environment variables (example)
#
# Copy the lines you need into your shell profile or a .env file and export
# them. NEVER commit real keys. Placeholders only — replace <your-key> with
# your actual value. Settings-driven config lives in ~/.pi/agent/settings.json,
# not here.

# ── Providers (packages/providers) ──────────────────────────────────────────

# Venice provider (agent-zero proxy; model catalog file required — see packages/providers)
AGENT_ZERO_API_KEY=<your-agent-zero-gateway-key>

# Optional key-ring rotation: the ring scans AGENT_ZERO_API_KEY_P0..P9 when
# present, falling back to the bare variable. Add as many as you want to rotate.
# AGENT_ZERO_API_KEY_P0=<key-1>
# AGENT_ZERO_API_KEY_P1=<key-2>

# Optional: non-default model-catalog file (default ~/.pi/agent/venice-models.json)
# VENICE_CATALOG_FILE=/path/to/venice-models.json

# ── Telegram channel (packages/telegram) ────────────────────────────────────

# Required to enable the channel — no token, no telegram tools (if-has-token guard)
# BRAID_TG_BOT_TOKEN=<your-bot-token>        (alias TELEGRAM_BOT_TOKEN also accepted)

# Owner chat/user id for outbound sends and the allow-list bootstrap
# BRAID_TG_CHAT_ID=<your-chat-id>

# Extra allow-listed users (comma-separated ids or @usernames)
# BRAID_TG_ALLOWED_USERS=<id1>,<id2>

# Optional tuning; the full table is in packages/telegram/README.md:
# BRAID_TG_STATE_FILE=/path/to/telegram-state.json   # offset/state file (default <cwd>/.braid/telegram-state.json)
# BRAID_TG_POLL_ENABLED=1                            # auto-start the background poller at load (default off)
# BRAID_TG_POLL_INTERVAL_MS=1500                     # background poller cadence
# BRAID_TG_NOTIFY_ENABLED=1                          # turn-complete auto-notify (default off)
# BRAID_TG_LIVE_UPDATE_ENABLED=0                     # disable the live "Working…" tracker (default on)

# ── Loader (packages/core) ──────────────────────────────────────────────────

# Comma-separated extension ids / module groups (memory, heartbeat). Bare and
# +refs enable, -refs disable; when at least one valid enabled ref is present it
# defines the loaded set instead of merging with the defaults. Unset = defaults.
# BRAID_MODULES=-watchdog
