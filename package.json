{
  "name": "pi-braid",
  "version": "0.3.0",
  "description": "Metacognitive extension suite for Pi: memory, enforcement, project management and llm assisted tools, with self-improvement and self-reflection in mind.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "src/",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kifirkin/pi-braid.git"
  },
  "bugs": {
    "url": "https://github.com/kifirkin/pi-braid/issues"
  },
  "homepage": "https://github.com/kifirkin/pi-braid#readme",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "prepublishOnly": "npm run typecheck && npm run build",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run clean",
    "build": "tsc",
    "test": "npm run build && node scripts/run-tests.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "check:deps": "node scripts/check-deps.mjs",
    "check:docs": "node scripts/check-doc-status.mjs",
    "check:doc-drift": "node scripts/check-doc-drift.mjs",
    "ci:check": "npm run check:docs && npm run check:doc-drift && npm run check:deps && npx tsc --noEmit && npm test",
    "release:local": "npm run build && npm pack && mkdir -p ~/.pi/agent/local-packages && cp pi-braid-*.tgz ~/.pi/agent/local-packages/ && cd ~/.pi/agent/local-packages && npm install ./pi-braid-*.tgz"
  },
  "dependencies": {
    "pi-braid-lib": "file:../pi-braid-lib",
    "typebox": "1.1.34"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "prettier": "3.8.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.59.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.80.0",
    "@earendil-works/pi-ai": ">=0.80.0",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-tui": ">=0.80.0"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "llm-agent",
    "cognitive-systems",
    "enforcement",
    "planning",
    "metacognition",
    "self-improvement",
    "memory-management"
  ],
  "author": "Alex Mironoff",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
