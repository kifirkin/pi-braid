{
	"name": "pi-braid",
	"version": "0.1.0",
	"description": "Self-contained pi-coding-agent extension bundling all develop-branch functionality: cognitive systems, planning, enforcement, feedback, skills, and advanced tools.",
	"type": "module",
	"main": "./src/index.ts",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"build": "npx esbuild src/index.ts --bundle --format=cjs --platform=node --out-extension:.js=.cjs --outdir=dist",
		"test": "node scripts/run-tests.mjs"
	},
	"dependencies": {
		"pdf-parse": "2.4.5",
		"typebox": "^1.0.0"
	},
	"peerDependencies": {
		"@mariozechner/pi-agent-core": ">=0.65.0",
		"@mariozechner/pi-ai": ">=0.65.0",
		"@mariozechner/pi-coding-agent": "0.69.0"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"coding-agent",
		"cognitive-systems",
		"enforcement",
		"planning"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "25.6.0",
		"@types/pdf-parse": "1.1.5",
		"typescript": "6.0.2"
	}
}
