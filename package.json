{
	"name": "pi-braid",
	"version": "0.1.0",
	"description": "Self-contained pi-coding-agent extension bundling all develop-branch functionality: cognitive systems, planning, enforcement, feedback, skills, and advanced tools.",
	"type": "module",
	"main": "./src/index.ts",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "tsc",
		"test": "npm run build && node scripts/run-tests.mjs",
		"clean": "rm -rf dist *.tsbuildinfo"
	},
	"dependencies": {
		"typebox": "1.1.34"
	},
	"devDependencies": {
		"@types/node": "25.6.0",
		"@types/pdf-parse": "1.1.5",
		"pdf-parse": "2.4.5",
		"typescript": "6.0.2"
	},
	"peerDependencies": {
		"@mariozechner/pi-agent-core": ">=0.70.0",
		"@mariozechner/pi-ai": ">=0.70.0",
		"@mariozechner/pi-coding-agent": ">=0.70.0"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"coding-agent",
		"cognitive-systems",
		"enforcement",
		"planning"
	],
	"license": "MIT"
}
