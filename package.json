{
	"name": "pi-braid",
	"version": "1.0.0",
	"description": "Metacognitive pi-coding-agent extension: enforcement, planning, memory, heartbeat scheduling, RepE contrast vectors, and utility tools (codebase analysis, REPL, browser automation).",
	"type": "module",
	"main": "./src/index.ts",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "tsc",
		"test": "npm run build && node scripts/run-tests.mjs",
		"clean": "rm -rf dist *.tsbuildinfo",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint src/ --max-warnings 0",
		"lint:fix": "eslint src/ --fix"
	},
	"dependencies": {
		"typebox": "1.1.34"
	},
	"devDependencies": {
		"@types/node": "25.6.0",
		"@types/pdf-parse": "1.1.5",
		"pdf-parse": "2.4.5",
		"typescript": "6.0.2"
	},
	"peerDependencies": {
		"@mariozechner/pi-agent-core": ">=0.70.0",
		"@mariozechner/pi-ai": ">=0.70.0",
		"@mariozechner/pi-coding-agent": ">=0.70.0"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"coding-agent",
		"cognitive-systems",
		"enforcement",
		"planning"
	],
	"license": "MIT"
}