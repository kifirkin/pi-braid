{
  "name": "pi-braid",
  "version": "0.2.0",
  "description": "Metacognitive extension suite for Pi: memory, enforcement, project management and llm assisted tools, with self-improvement and self-reflection in mind.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/",
    "skills/",
    "docs/",
    "braid-os/",
    "src/",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kifirkin/pi-braid.git"
  },
  "bugs": {
    "url": "https://github.com/kifirkin/pi-braid/issues"
  },
  "homepage": "https://github.com/kifirkin/pi-braid#readme",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "prepublishOnly": "npm run typecheck && npm run build",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node scripts/run-tests.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "typebox": "1.1.34"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "@types/pdf-parse": "1.1.5",
    "@types/ws": "8.18.1",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "prettier": "3.8.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.59.1"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": ">=0.70.0",
    "@mariozechner/pi-ai": ">=0.70.0",
    "@mariozechner/pi-coding-agent": ">=0.70.0"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "llm-agent",
    "cognitive-systems",
    "enforcement",
    "planning",
    "metacognition",
    "self-improvement",
    "memory-management"
  ],
  "author": "Kifir Kifirkin",
  "license": "MIT"
}
