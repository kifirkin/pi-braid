# Build output
dist/
packages/core/dist/
packages/lib/dist/
*.d.ts.map
*.js.map

# TypeScript incremental build
*.tsbuildinfo

# Test results
test/runtime/results/

# Session data
*.jsonl

# Archives
.archive/

# Braid work artifacts (deliverables, session metadata)
.braid/

# OS / temp
.DS_Store
*.log

# Editor
.vscode/
.idea/
*.swp
*.swo

# modules
node_modules/
__pycache__/

# Pi /export
pi-session-*

# Session HTML exports
pi-session-*.html

# Environment / secrets
.env
.env.*
!.env.example

# Package artifacts
*.tgz
# Pack-time provenance record (written by publish-local.mjs, removed after the
# pack); ignored so an interrupted publish cannot leave the checkout dirty
build-info.json

# Changelog staged into the package for a pack (scripts/stage-changelog.mjs);
# the repository keeps one copy, at the root, and it is not tracked here twice
packages/core/CHANGELOG.md
